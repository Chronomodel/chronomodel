<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>ChronoModel</Name>
    <Version>4.0.0</Version>
    <Title>ChronoModel</Title>
    <Publisher>ChronoModel Team</Publisher>
    <ProductUrl>https://chronomodel.com</ProductUrl>
    <TargetDir>@ApplicationsDir@/Chronomodel</TargetDir>

    <!-- Lancer l'application en fin d'installation, selon l'OS : config.xml est un
         fichier XML statique, il n'execute aucun script. Cette logique doit passer
         par installscript.qs (hook installer.installationFinished), pas par ici. -->

    <InstallerWindowIcon>Chronomodel_Installer</InstallerWindowIcon> <!-- pour Windows et Linux -->
    <InstallerApplicationIcon>Chronomodel_Installer</InstallerApplicationIcon>
    <!-- Le fichier reel est cherche avec l'extension '.icns' (macOS) ou '.ico' (Windows).
         Aucun effet sur Linux. -->
    <Logo>Chronomodel.png</Logo>
    <MaintenanceToolName>Chronomodel_uninstaller</MaintenanceToolName>

    <!-- Fond d'ecran : seul Watermark fonctionne (StyleSheet/Background testes, sans effet) -->
    <Watermark>fond_ecran</Watermark>
    <WizardShowPageList>true</WizardShowPageList>
    <WizardStyle>Modern</WizardStyle>

    <StartMenuDir>ChronoModel</StartMenuDir> <!-- Uniquement sur Windows -->

    <ProductImages>
        <ProductImage>
            <Image>Bzh_curve.png</Image>
        </ProductImage>
        <ProductImage>
            <Image>MCMC_Box.png</Image>
        </ProductImage>
    </ProductImages>
</Installer>